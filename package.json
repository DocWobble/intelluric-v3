{
  "name": "intelluric-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "tokens:build": "node packages/design-tokens/scripts/build.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build.mjs --check",
    "visual:hydrate": "node scripts/hydrate-visual-fixtures.mjs",
    "visual:check": "node scripts/check-visual-authority.mjs && node scripts/check-optimized-homepage-source.mjs",
    "check": "npm run tokens:check && npm run visual:check"
  },
  "engines": { "node": ">=20" }
}
