      "thumbnail-width": { "$type": "dimension", "$value": "7.25rem" },
      "thumbnail-gap": { "$type": "dimension", "$value": "{space.3}" }
    },
    "label": {
      "font-family": { "$type": "fontFamily", "$value": "{font.family.technical}" },
      "font-size": { "$type": "dimension", "$value": "{font.size.2xs}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
      "tracking": { "$type": "dimension", "$value": "{font.tracking.label}" }
