        "gutter": { "$type": "dimension", "$value": "{layout.gutter-desktop}" }
      },
      "instrument": {
        "max-width": { "$type": "dimension", "$value": "100%" },
        "header-height": { "$type": "dimension", "$value": "{layout.header-instrument}" },
