        "gutter": { "$type": "dimension", "$value": "{space.5}" }
      }
    },
    "frame": {
      "radius": { "$type": "dimension", "$value": "{radius.frame}" },
      "padding": { "$type": "dimension", "$value": "{space.6}" },
      "gap": { "$type": "dimension", "$value": "{space.4}" }
    },
    "panel": {
      "radius": { "$type": "dimension", "$value": "{radius.panel}" },
      "padding": { "$type": "dimension", "$value": "{space.5}" },
      "gap": { "$type": "dimension", "$value": "{space.4}" }
    },
    "button": {
      "height": { "$type": "dimension", "$value": "{layout.control-min}" },
      "padding-inline": { "$type": "dimension", "$value": "{space.6}" },
      "gap": { "$type": "dimension", "$value": "{space.3}" },
