{
  "color": {
    "background": {
      "$type": "color",
      "canvas": { "$value": "{color.ink.950}" },
      "canvas-deep": { "$value": "{color.ink.1000}" },
      "canvas-raised": { "$value": "{color.ink.900}" }
    },
    "surface": {
      "$type": "color",
      "frame": { "$value": "rgba(7, 22, 33, 0.86)" },
      "panel": { "$value": "rgba(7, 22, 33, 0.76)" },
      "panel-strong": { "$value": "rgba(10, 27, 39, 0.92)" },
      "control": { "$value": "rgba(16, 36, 49, 0.72)" },
      "control-hover": { "$value": "rgba(22, 48, 63, 0.82)" },
      "scrim": { "$value": "{color.black-alpha.72}" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "{color.ivory.50}" },
      "heading": { "$value": "{color.ivory.100}" },
      "secondary": { "$value": "{color.steel.200}" },
      "muted": { "$value": "{color.steel.400}" },
      "disabled": { "$value": "{color.steel.500}" },
      "technical": { "$value": "{color.steel.300}" },
      "on-light": { "$value": "{color.ink.950}" }
    },
    "border": {
      "$type": "color",
      "frame": { "$value": "rgba(173, 105, 70, 0.48)" },
      "frame-hover": { "$value": "rgba(201, 139, 98, 0.74)" },
      "panel": { "$value": "rgba(117, 131, 145, 0.30)" },
      "panel-strong": { "$value": "rgba(150, 163, 176, 0.46)" },
      "subtle": { "$value": "rgba(117, 131, 145, 0.18)" },
      "separator": { "$value": "rgba(150, 163, 176, 0.16)" }
    },
    "accent": {
      "$type": "color",
      "context": { "$value": "{color.teal.300}" },
      "context-strong": { "$value": "{color.teal.200}" },
      "context-dim": { "$value": "{color.teal.600}" },
      "context-border": { "$value": "rgba(101, 217, 204, 0.72)" },
      "context-fill": { "$value": "rgba(56, 188, 175, 0.13)" },
      "context-glow": { "$value": "rgba(56, 188, 175, 0.30)" }
    },
    "status": {
      "success": {
        "$type": "color",
        "text": { "$value": "{color.green.300}" },
        "border": { "$value": "rgba(76, 185, 137, 0.50)" },
        "fill": { "$value": "rgba(42, 128, 95, 0.18)" }
      },
      "warning": {
        "$type": "color",
        "text": { "$value": "{color.amber.200}" },
        "border": { "$value": "rgba(230, 169, 88, 0.50)" },
        "fill": { "$value": "rgba(134, 85, 31, 0.18)" }
      },
      "danger": {
        "$type": "color",
        "text": { "$value": "{color.red.300}" },
        "border": { "$value": "rgba(216, 100, 100, 0.52)" },
        "fill": { "$value": "rgba(146, 62, 67, 0.18)" }
      },
      "info": {
        "$type": "color",
        "text": { "$value": "{color.sapphire.200}" },
        "border": { "$value": "rgba(75, 143, 232, 0.52)" },
        "fill": { "$value": "rgba(40, 95, 168, 0.18)" }
      }
    }
  },
  "material": {
    "$type": "gradient",
    "canvas": {
      "$value": "radial-gradient(circle at 72% 8%, rgba(40, 95, 168, 0.10), transparent 34%), radial-gradient(circle at 10% 80%, rgba(56, 188, 175, 0.055), transparent 30%), linear-gradient(180deg, #02070C 0%, #041019 52%, #02070C 100%)"
    },
    "frame": {
      "$value": "linear-gradient(145deg, rgba(10, 27, 39, 0.92), rgba(4, 16, 25, 0.92))"
    },
    "panel": {
      "$value": "linear-gradient(145deg, rgba(10, 27, 39, 0.82), rgba(4, 16, 25, 0.78))"
    },
    "panel-elevated": {
      "$value": "linear-gradient(145deg, rgba(16, 36, 49, 0.94), rgba(4, 16, 25, 0.92))"
    },
    "crystal": {
      "$value": "linear-gradient(180deg, rgba(157, 236, 226, 0.16), rgba(13, 81, 79, 0.26) 48%, rgba(2, 7, 12, 0.28))"
    },
    "control": {
      "$value": "linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015))"
    },
    "brushed-line": {
      "$value": "repeating-linear-gradient(90deg, rgba(255,255,255,0.016) 0, rgba(255,255,255,0.016) 1px, transparent 1px, transparent 4px)"
    },
    "technical-grid": {
      "$value": "linear-gradient(rgba(125,178,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(125,178,255,0.035) 1px, transparent 1px)"
    }
  },
  "shadow": {
    "$type": "shadow",
    "accent": { "$value": "0 0 0 1px var(--it-color-accent-context-border), 0 0 28px var(--it-color-accent-context-glow), inset 0 1px 0 rgba(255,255,255,0.08)" },
    "accent-soft": { "$value": "0 0 20px var(--it-color-accent-context-glow)" }
  }
}

